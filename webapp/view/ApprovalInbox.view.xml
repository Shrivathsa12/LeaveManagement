
<mvc:View
    controllerName="leaveui5.controller.ApprovalInbox"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Page
        id="approvalInboxPage"
        title="My Approval Inbox"
        showNavButton="true"
        navButtonPress=".onNavBack"
    >
        <content>
            <VBox
                class="sapUiResponsiveContentPadding"
                width="100%"
            >
                <Toolbar>
                    <Title
                        text="Pending Leave Approvals"
                        level="H2"
                    />
                    <ToolbarSpacer />
                    <Button
                        text="Refresh"
                        icon="sap-icon://refresh"
                        type="Emphasized"
                        press=".onRefresh"
                    />
                </Toolbar>

                <MessageStrip
                    text="Tasks are fetched from SAP Build Process Automation through the CAP service."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <Table
                    id="approvalTasksTable"
                    items="{inbox>/tasks}"
                    mode="SingleSelectMaster"
                    selectionChange=".onTaskSelect"
                    noDataText="No pending approval tasks found"
                >
                    <columns>
                        <Column>
                            <Text text="Task ID" />
                        </Column>
                        <Column>
                            <Text text="Status" />
                        </Column>
                        <Column>
                            <Text text="Assigned To" />
                        </Column>
                        <Column>
                            <Text text="Leave Request ID" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Active">
                            <cells>
                                <Text text="{inbox>id}" />
                                <ObjectStatus
                                    text="{inbox>status}"
                                    state="Information"
                                />
                                <Text text="{inbox>assignedTo}" />
                                <Text text="{inbox>leaveRequestID}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <Panel
                    headerText="Selected Task Details"
                    expandable="true"
                    expanded="true"
                    class="sapUiMediumMarginTop"
                >
                    <content>
                        <ObjectHeader
                            title="{inboxSelected>/id}"
                            intro="BPA Approval Task"
                        >
                            <statuses>
                                <ObjectStatus
                                    text="{inboxSelected>/status}"
                                    state="Information"
                                />
                            </statuses>
                        </ObjectHeader>

                        <form:SimpleForm
                            editable="false"
                            layout="ResponsiveGridLayout"
                            columnsXL="2"
                            columnsL="2"
                            columnsM="1"
                        >
                            <form:content>
                                <Label text="Leave Request ID" />
                                <Text text="{inboxSelected>/leaveRequestID}" />

                                <Label text="Assigned To" />
                                <Text text="{inboxSelected>/assignedTo}" />

                                <Label text="Employee Name" />
                                <Text text="{inboxSelected>/employeeName}" />

                                <Label text="Employee Email" />
                                <Text text="{inboxSelected>/employeeEmail}" />

                                <Label text="Leave Type" />
                                <Text text="{inboxSelected>/leaveType}" />

                                <Label text="Start Date" />
                                <Text text="{inboxSelected>/startDate}" />

                                <Label text="End Date" />
                                <Text text="{inboxSelected>/endDate}" />

                                <Label text="Total Days" />
                                <Text text="{inboxSelected>/totalDays}" />

                                <Label text="Reason" />
                                <Text text="{inboxSelected>/reason}" />
                            </form:content>
                        </form:SimpleForm>

                        <HBox
                            class="sapUiMediumMarginTop"
                            justifyContent="End"
                            alignItems="Center"
                        >
                            <Button
                                text="Approve"
                                icon="sap-icon://accept"
                                type="Accept"
                                press=".onApproveTask"
                                class="sapUiTinyMarginEnd"
                            />

                            <Button
                                text="Reject"
                                icon="sap-icon://decline"
                                type="Reject"
                                press=".onRejectTask"
                            />
                        </HBox>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
